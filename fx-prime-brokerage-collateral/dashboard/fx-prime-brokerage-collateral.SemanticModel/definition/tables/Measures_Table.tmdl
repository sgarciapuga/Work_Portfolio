	measure 'Initial Margin (% Daily Change)' = DIVIDE([Initial Margin] - [Initial Margin (Previous Day)], [Initial Margin (Previous Day)])
		displayFolder: MTM
		lineageTag: cd35cbc2-fbc2-426b-9ff2-eaa7ae265221

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IM Jump Flag' = IF([Initial Margin (% Daily Change)] > 0.1, 1, 0)
		formatString: 0
		displayFolder: MTM
		lineageTag: 800c5f28-4197-4be3-ace6-f617e1b8eaee

	measure 'IM Jump Marker' = IF([IM Jump Flag] = 1, [Initial Margin (Inverse)], BLANK())
		displayFolder: MTM
		lineageTag: b40a3f23-181a-46ed-a34f-6c75fbe7ac83

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Has Data Flag' = ```
			
