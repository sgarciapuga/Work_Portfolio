table Measures_Table
	lineageTag: 1f1cb31f-8341-4134-81c0-d0af2977bc44

	measure 'Selected Date' = SELECTEDVALUE(dim_date[calendar_date])
		formatString: dd/mmm/yyyy
		lineageTag: f3bdff2d-cc31-4ad7-9a65-414abdf1fb51

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Initial Margin' = SUM(mtm_report[initial_margin])
		displayFolder: MTM
		lineageTag: f32b64f0-93f3-40e3-a7a7-5776d78f4ef0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variation Margin' = SUM(mtm_report[variation_margin])
		displayFolder: MTM
		lineageTag: a2559f93-9a0f-43e0-b464-76a886740875

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Collateral Required' = SUM(mtm_report[collateral_required])
		displayFolder: MTM
		lineageTag: d2b837c7-390d-4a73-be4f-f4d9cf053c81

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Collateral Posted' = SUM(mtm_report[collateral_posted])
		formatString: #,0
		displayFolder: MTM
		lineageTag: 64d893c1-a98c-4334-bb68-0124d827d879

	measure 'Excess / Deficit' = SUM(mtm_report[excess_deficit])
		displayFolder: MTM
		lineageTag: 078c303a-9ce4-4c0b-9457-9d6a64dd6a8c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IM 30 Day Moving Average' =
			
			
			
			CALCULATE(
			    AVERAGEX(
			        DATESINPERIOD(
			            dim_date[calendar_date],
			            MAX(dim_date[calendar_date]),
			            -30,
			            DAY
			        ),
			        [Initial Margin (Inverse)]
			    )
			)
		displayFolder: MTM
		lineageTag: 61c82803-8554-4d83-afbb-83366d41eeb9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variation Margin (Inverse)' = SUM(mtm_report[variation_margin])
		displayFolder: MTM
		lineageTag: e23d74c4-56a8-4f61-b5ce-0b44651bf349

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Initial Margin (Inverse)' = -1 * SUM(mtm_report[initial_margin])
		displayFolder: MTM
		lineageTag: 1984a8ef-9503-49a3-8ad4-1e26c61d7065

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Counterparty Limits' = SUM(limits[credit_limit_usd])
		formatString: #,0
		lineageTag: 7d4d5501-1f70-467e-acf0-cd4a5a8dde25

	measure 'FX Portfolio Size' = SUM(fx_portfolio[trade_size_usd])
		formatString: #,0.00
		displayFolder: Portfolio
		lineageTag: cfdd378a-ff8e-4533-ad87-ea7b7cd2a93f

	measure 'Open Trades' = COUNTROWS(fx_portfolio)
		formatString: 0
		displayFolder: Portfolio
		lineageTag: c3291695-b1b4-44d9-81a7-6a9bc8a80319

	measure 'Collateral Required (Inverse)' = -1 * SUM(mtm_report[collateral_required])
		displayFolder: MTM
		lineageTag: f7b52d97-eadb-4b74-8bb5-f1f7dea0317a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'VM 30 Day Moving Average' =
			
			
			
			CALCULATE(
			    AVERAGEX(
			        DATESINPERIOD(
			            dim_date[calendar_date],
			            MAX(dim_date[calendar_date]),
			            -30,
			            DAY
			        ),
			        [Variation Margin (Inverse)]
			    )
			)
		displayFolder: MTM
		lineageTag: ca048677-4bc0-4e62-99f4-2bf26e77e35c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Collateral Posted (Previous Day)' = ```
			
			VAR CurrentDate = MAX(dim_date[calendar_date])
			VAR PRevious_DateWithData = 
			CALCULATE(
			    MAX(mtm_report[report_date]),
			    REMOVEFILTERS(dim_date),
			    dim_date[calendar_date] < CurrentDate
			)
			
			RETURN
			
			CALCULATE(
			    [Collateral Posted],
			    REMOVEFILTERS(dim_date),
			    dim_date[calendar_date] = PRevious_DateWithData
			)
			```
		displayFolder: MTM
		lineageTag: 92f23517-749e-4102-8350-b80a3a0c90c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Collateral Posted (Daily Change)' = [Collateral Posted] - [Collateral Posted (Previous Day)]
		displayFolder: MTM
		lineageTag: b29180a0-884d-4737-a09d-0d127343c454

		formatStringDefinition =
				VAR Change = [Collateral Posted (Daily Change)]
				RETURN
				
				    SWITCH(
				    TRUE(),
				    Change> 0, "▲ " & "#,0",
				    Change < 0, "▼ " & "#,0",
				    "- -"
				)

	measure 'Collateral Posted  Change Colour' =
			
			SWITCH(
			    TRUE(),
			    [Collateral Posted (Daily Change)] > 0, "#1F7A4D",   // green
			    [Collateral Posted (Daily Change)]  < 0, "#7A0C1E",   // red
			    "#808080"                        // grey for no change
			)
		displayFolder: MTM
		lineageTag: d986cf09-8716-42dd-89d5-3edd0b9fc23b

	measure 'Initial Margin (Previous Day)' =
			VAR CurrentDate = MAX(dim_date[calendar_date])
			VAR Previous_DateWithData =
			    CALCULATE(
			        MAX(mtm_report[report_date]),
			        dim_date[calendar_date] < CurrentDate
			    )
			RETURN
			    CALCULATE(
			        [Initial Margin],
			        dim_date[calendar_date] = Previous_DateWithData
			    )
		displayFolder: MTM
		lineageTag: 70101313-758e-4470-91d7-3d66a312f29d

