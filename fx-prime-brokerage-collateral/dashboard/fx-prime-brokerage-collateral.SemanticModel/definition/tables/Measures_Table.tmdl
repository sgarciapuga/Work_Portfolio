	measure 'Total Limit' =
			CALCULATE(
			    SUM(limits[credit_limit_usd]),
			    ALLEXCEPT(limits, limits[as_of_date])
			)
		displayFolder: Portfolio
		lineageTag: 6d486fe4-6e96-4d8d-b349-00e53b5a7992

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Credit Limit Utilization' = ```
			
			DIVIDE(
			    SUM('limits'[counterparty_exposure_usd]), 
			    SUM('limits'[credit_limit_usd]), 
			    0
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6e0511d5-c596-4adc-90f7-b0c7c500537e

	measure 'Bank Theme Color' =
			
			VAR SelectedBank = SELECTEDVALUE('dim_banks'[bank_code])
			RETURN
			    SWITCH(
			        SelectedBank,
			        "SAN", "#EC0000",  -- Official Santander Red
			        "CITI", "#003B70",  -- Official Citi Blue
			        "HSBC", "#800020",  -- Official HSBC Red
			        "JPM", "#117ACA",  -- Official JPMorgan Blue
			        "FXPB", "#E28743",  -- Distinct Accent Orange
			        "#888888"                      -- Default Grey
			    )
		lineageTag: 76a60422-5570-4dec-8fe9-4968fe3ac957

	partition Measures_Table = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

