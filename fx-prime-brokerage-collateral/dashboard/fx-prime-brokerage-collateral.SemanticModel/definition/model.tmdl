model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_date","dim_currencies","dim_banks","Measures_Table","fx_rates","fx_portfolio","limits","mtm_report"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_date
ref table Measures_Table
ref table fx_rates
ref table dim_currencies
ref table dim_banks
ref table fx_portfolio
ref table limits
ref table mtm_report

ref cultureInfo en-US

