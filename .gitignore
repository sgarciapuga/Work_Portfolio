# Exclude environment secrets
.env
.env.*
.Renviron

# Python
__pycache__/
*.pyc
*.egg-info/

# RStudio & R Markdown outputs
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*_files/
!docs/**/*_files/
*_cache/
!docs/**/*_cache/

# ProcDump (Sysinternals; not redistributable). capture_python_dump.ps1 downloads it when missing.
scripts/procdump/

# Microsoft Office temporary files
~$*.pptx

# Power BI Project (.pbip) ignore rules
*.tmp
*.log
**/.pbi/cache.abf
**/.pbi/localSettings.json
**/.pbi/userSettings.json

/.quarto/
**/*.quarto_ipynb

